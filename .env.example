# =============================================================================
# Interchained tri-PoW pool: example environment configuration
#
# Copy this file to ".env" in the repo root, fill in at least the daemon
# section and the pool address, then start the pool:
#
#     cp .env.example .env
#     # edit .env
#     node start.js
#
# start.js loads ".env" automatically when it exists. You can also export
# any of these variables in your shell instead; a real environment
# variable always wins over the value in the file.
#
# Precedence, highest first:
#     environment (shell, then .env file)  >  JSON config  >  built-in default
#
# A variable left unset, or set to an empty value, changes nothing.
# A variable set to an invalid value (a non-numeric port, an unknown
# scheme) stops the pool at startup with an error naming the variable.
# That is deliberate: a typo must fail loudly, not fall back silently.
#
# Values marked CHANGE_ME are placeholders. Never commit a filled-in
# .env file with real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Config file selection
# -----------------------------------------------------------------------------

# ITC_POOL_CONFIG
#   What: path to the JSON config file layered under these variables.
#   Default if unset: config/interchained-mainnet.json
#   Without it: nothing breaks; the default mainnet config is used.
ITC_POOL_CONFIG=config/interchained-mainnet.json


# -----------------------------------------------------------------------------
# Daemon: the one Interchained daemon (interchainedd) all three pools share
# -----------------------------------------------------------------------------

# ITC_DAEMON_HOST
#   What: host of the daemon RPC interface.
#   Default if unset: the JSON value, normally 127.0.0.1
#   Without it: the pool talks to the JSON host. Keep this on loopback
#   unless the daemon lives on a separate private-network host.
ITC_DAEMON_HOST=127.0.0.1

# ITC_DAEMON_PORT
#   What: daemon RPC port (the rpcport in interchained.conf).
#   Default if unset: the JSON value, normally 8332
#   Without it: nothing breaks if the JSON port already matches the
#   daemon. A mismatch means no block templates and no mining at all.
ITC_DAEMON_PORT=8332

# ITC_DAEMON_USER
#   What: daemon RPC user (rpcuser in interchained.conf).
#   Default if unset: the JSON value
#   Without it: RPC authentication fails and the pool gets no work.
#   Replace CHANGE_ME with your daemon's rpcuser.
ITC_DAEMON_USER=CHANGE_ME_RPC_USER

# ITC_DAEMON_PASSWORD
#   What: daemon RPC password (rpcpassword in interchained.conf).
#   Default if unset: the JSON value
#   Without it: RPC authentication fails and the pool gets no work.
#   Replace CHANGE_ME with your daemon's rpcpassword. Treat it as a
#   secret: anyone holding it controls the daemon and its wallet.
ITC_DAEMON_PASSWORD=CHANGE_ME_RPC_PASSWORD


# -----------------------------------------------------------------------------
# Wallets and branding
# -----------------------------------------------------------------------------

# ITC_POOL_ADDRESS
#   What: the ITC address the coinbase pays. Solo mode: your own payout
#   address. Group modes (PROP/PPLNS): the pool wallet address, which
#   the daemon wallet must control, because payouts are built from it.
#   Default if unset: the JSON "address" value
#   Without it: start.js refuses to start if the JSON config has no
#   address either. A wrong address loses block rewards permanently.
ITC_POOL_ADDRESS=CHANGE_ME_ITC_ADDRESS

# ITC_POOL_NAME
#   What: display name for this pool instance, printed at startup.
#   Default if unset: no pool name is printed
#   Without it: nothing breaks; it is branding and log identification
#   only, useful when one host runs more than one pool.
ITC_POOL_NAME=

# ITC_COIN_NAME
#   What: coin display name passed to the pool engine.
#   Default if unset: Interchained
#   Without it: nothing breaks. Only change it for a fork or a testnet
#   with a different coin identity.
ITC_COIN_NAME=Interchained

# ITC_COIN_SYMBOL
#   What: coin ticker passed to the pool engine.
#   Default if unset: ITC
#   Without it: nothing breaks. See ITC_COIN_NAME.
ITC_COIN_SYMBOL=ITC

# ITC_NETWORK
#   What: network label only (mainnet / regtest). The pool learns the
#   real chain from the daemon, not from this label.
#   Default if unset: the JSON value
#   Without it: nothing breaks; the label is informational.
ITC_NETWORK=mainnet


# -----------------------------------------------------------------------------
# Stratum and payout scheme per algorithm
# Ports: SHA256 = 3333, Yespower = 3334, Ethash = 3335.
# Schemes: solo (coinbase pays the address directly), prop (split over
# the current round), pplns (split over the last N shares).
# -----------------------------------------------------------------------------

# ITC_SHA256_ENABLED
#   What: run the SHA256 (ASIC) pool. Accepted: 1/true/yes/on, 0/false/no/off
#   Default if unset: the JSON value, normally true
#   Without it: nothing breaks. Set to 0 to run no SHA256 pool.
ITC_SHA256_ENABLED=1

# ITC_SHA256_STRATUM_PORT
#   What: port SHA256 miners connect to.
#   Default if unset: 3333
#   Without it: nothing breaks. Change it only to avoid a port clash,
#   and tell your miners the new port.
ITC_SHA256_STRATUM_PORT=3333

# ITC_SHA256_SCHEME
#   What: payout scheme for SHA256: solo, prop, or pplns.
#   Default if unset: solo
#   Without it: SHA256 runs solo. Group schemes need payments enabled
#   below, or no distributions are computed.
ITC_SHA256_SCHEME=solo

# ITC_SHA256_PPLNS_WINDOW
#   What: PPLNS window in shares for SHA256 (ignored unless pplns).
#   Default if unset: the top-level ITC_PAYMENTS_PPLNS_WINDOW
#   Without it: nothing breaks; the shared default applies.
ITC_SHA256_PPLNS_WINDOW=

# ITC_SHA256_DIFF
#   What: starting stratum difficulty for SHA256 miners. Variable
#   difficulty adjusts from here per miner.
#   Default if unset: the JSON value (2048 in the mainnet example)
#   Without it: nothing breaks. Tune it to your ASIC hashrate.
ITC_SHA256_DIFF=

# ITC_YESPOWER_ENABLED
#   What: run the Yespower (CPU) pool. Accepted: 1/true/yes/on, 0/false/no/off
#   Default if unset: the JSON value, normally true
#   Without it: nothing breaks. Set to 0 to run no Yespower pool.
ITC_YESPOWER_ENABLED=1

# ITC_YESPOWER_STRATUM_PORT
#   What: port Yespower miners connect to.
#   Default if unset: 3334
#   Without it: nothing breaks. See ITC_SHA256_STRATUM_PORT.
ITC_YESPOWER_STRATUM_PORT=3334

# ITC_YESPOWER_SCHEME
#   What: payout scheme for Yespower: solo, prop, or pplns.
#   Default if unset: solo
#   Without it: Yespower runs solo. See ITC_SHA256_SCHEME.
ITC_YESPOWER_SCHEME=solo

# ITC_YESPOWER_PPLNS_WINDOW
#   What: PPLNS window in shares for Yespower (ignored unless pplns).
#   Default if unset: the top-level ITC_PAYMENTS_PPLNS_WINDOW
#   Without it: nothing breaks; the shared default applies.
ITC_YESPOWER_PPLNS_WINDOW=

# ITC_YESPOWER_DIFF
#   What: starting stratum difficulty for Yespower miners.
#   Default if unset: the JSON value (8 in the mainnet example)
#   Without it: nothing breaks. Tune it to your CPU hashrate.
ITC_YESPOWER_DIFF=

# ITC_ETHASH_ENABLED
#   What: run the Ethash (GPU) pool. Accepted: 1/true/yes/on, 0/false/no/off
#   Default if unset: the JSON value, normally true
#   Without it: nothing breaks. Set to 0 to run no Ethash pool.
ITC_ETHASH_ENABLED=1

# ITC_ETHASH_STRATUM_PORT
#   What: port Ethash miners connect to (Ethash stratum dialect,
#   served by the Ethash adapter, not the classic stratum server).
#   Default if unset: 3335
#   Without it: nothing breaks. See ITC_SHA256_STRATUM_PORT.
ITC_ETHASH_STRATUM_PORT=3335

# ITC_ETHASH_SCHEME
#   What: payout scheme for Ethash: solo, prop, or pplns.
#   Default if unset: solo
#   Without it: Ethash runs solo. See ITC_SHA256_SCHEME.
ITC_ETHASH_SCHEME=solo

# ITC_ETHASH_PPLNS_WINDOW
#   What: PPLNS window in shares for Ethash (ignored unless pplns).
#   Default if unset: the top-level ITC_PAYMENTS_PPLNS_WINDOW
#   Without it: nothing breaks; the shared default applies.
ITC_ETHASH_PPLNS_WINDOW=

# ITC_ETHASH_DIFF
#   What: starting stratum difficulty for Ethash miners.
#   Default if unset: the JSON value (512 in the mainnet example)
#   Without it: nothing breaks. Tune it to your GPU hashrate.
ITC_ETHASH_DIFF=


# -----------------------------------------------------------------------------
# Payments processor (group modes: PROP and PPLNS)
# Records shares and blocks to a ledger and pays matured rewards as
# PSBTs from the pool wallet. Dry-run is the default everywhere.
# -----------------------------------------------------------------------------

# ITC_PAYMENTS_ENABLED
#   What: run the payments processor at all.
#   Accepted: 1/true/yes/on, 0/false/no/off
#   Default if unset: the JSON value (false in the mainnet example)
#   Without it: solo mining still works, but group-mode blocks are
#   never split or paid. Group schemes need this on.
ITC_PAYMENTS_ENABLED=0

# ITC_PAYMENTS_DRY_RUN
#   What: force dry-run ON. Accepted on values: 1/true/yes/on
#   Default if unset: the JSON value (true in both shipped examples)
#   Safety: setting this to "false" does NOT turn dry-run off. The
#   only environment path to live payments is ITC_PAYMENTS_LIVE=1
#   below, so a stray or misunderstood value can never move money.
ITC_PAYMENTS_DRY_RUN=1

# ITC_PAYMENTS_LIVE
#   What: THE live-payments switch. Only the exact value 1 turns
#   dry-run off and allows the PSBT signing stages and broadcast.
#   Default if unset: dry-run stays as configured (on, by default)
#   Warning: "true", "yes", "false" and every other value are NOT an
#   opt-in and leave dry-run untouched. Set this to 1 only after the
#   dry-run ledger and splits have been checked, the pool wallet is
#   funded with matured rewards, and you mean it. Left empty here on
#   purpose.
ITC_PAYMENTS_LIVE=

# ITC_PAYMENTS_FEE_PERCENT
#   What: pool fee, percent of each group-mode block reward, taken
#   before the split. Solo blocks are never charged.
#   Default if unset: the JSON value (1 in the shipped examples)
#   Without it: nothing breaks. 0 is a valid no-fee pool.
ITC_PAYMENTS_FEE_PERCENT=

# ITC_PAYMENTS_MIN_PAYOUT
#   What: minimum payout per miner, in ITC. Below this, a miner's
#   amount stays as a pending balance and carries forward.
#   Default if unset: the JSON value (0.5 mainnet, 0.01 regtest)
#   Without it: nothing breaks. Too low sends dust; too high makes
#   small miners wait a long time for a first payout.
ITC_PAYMENTS_MIN_PAYOUT=

# ITC_PAYMENTS_CONFIRMATIONS
#   What: confirmations a group-mode block must reach before its
#   reward is distributed.
#   Default if unset: the JSON value (100 mainnet, 1 regtest)
#   Without it: nothing breaks. Keep it at or above the chain's
#   coinbase maturity: the reward is not spendable before then, and
#   an orphaned block's reward does not exist at all.
ITC_PAYMENTS_CONFIRMATIONS=

# ITC_PAYMENTS_INTERVAL_SECONDS
#   What: how often the processor checks for matured blocks and runs
#   distributions, in seconds.
#   Default if unset: the JSON value (600 mainnet, 30 regtest)
#   Without it: nothing breaks. Very small values only poll the
#   daemon more often.
ITC_PAYMENTS_INTERVAL_SECONDS=

# ITC_PAYMENTS_PPLNS_WINDOW
#   What: default PPLNS window in shares, for pplns algorithms that
#   do not set their own per-algorithm window above.
#   Default if unset: the JSON value (10000 mainnet, 1000 regtest)
#   Without it: nothing breaks for solo or prop; a pplns algorithm
#   with no window anywhere falls back in the payments processor.
ITC_PAYMENTS_PPLNS_WINDOW=

# ITC_PAYMENTS_DATA_FILE
#   What: path of the payments ledger (shares, blocks, balances,
#   payout batches with their PSBTs). Back this file up.
#   Default if unset: api/data/payouts.json in the repo
#   Without it: the ledger lives at the default path. Point it at
#   persistent storage if the repo directory is not persistent.
ITC_PAYMENTS_DATA_FILE=


# -----------------------------------------------------------------------------
# Stats API
# -----------------------------------------------------------------------------

# ITC_API_PORT
#   What: port of the stats API and dashboard (the "api.port" config
#   value). The standalone API server (node api/server.js) listens on
#   this port; the legacy PORT variable still works as a fallback
#   when ITC_API_PORT is unset.
#   Default if unset: 8080
#   Without it: nothing breaks. Change it to avoid a port clash.
ITC_API_PORT=8080

# ITC_CHAT_DIR
#   What: directory of the pool chat's NEDB database. Chat messages
#   are NEDB puts in a hash-chained DAG (api/chatStore.js), served
#   at GET/POST /api/chat; every dashboard tab replays them into
#   its own nedb-wasm replica and verifies the chain locally.
#   Requires the nedb-engine npm package (in package.json). If it
#   is missing, chat answers 503 and nothing else is affected.
#   Default if unset: api/data/chat-nedb in the repo
# ITC_CHAT_DIR=/var/lib/interchained-pool/chat-nedb

# ITC_API_HOST
#   What: host/interface name recorded for the stats API in the pool
#   config (api.host).
#   Default if unset: no host recorded; the API listens as started
#   Without it: nothing breaks. The dashboard and API expose
#   operational information; keep them on a trusted interface or
#   behind a reverse proxy, VPN, or LAN-only binding.
ITC_API_HOST=


# -----------------------------------------------------------------------------
# Pool tuning
# -----------------------------------------------------------------------------

# ITC_BLOCK_REFRESH_INTERVAL
#   What: how often each pool polls the daemon for a new block
#   template, in milliseconds.
#   Default if unset: the JSON value (1000 mainnet, 500 regtest)
#   Without it: nothing breaks. Smaller means fresher jobs and more
#   daemon load.
ITC_BLOCK_REFRESH_INTERVAL=

# ITC_JOB_REBROADCAST_TIMEOUT
#   What: seconds of silence after which the current job is
#   rebroadcast to miners.
#   Default if unset: the JSON value (55)
#   Without it: nothing breaks.
ITC_JOB_REBROADCAST_TIMEOUT=

# ITC_CONNECTION_TIMEOUT
#   What: seconds without contact before a miner connection drops.
#   Default if unset: the JSON value (600)
#   Without it: nothing breaks. Too small drops miners on brief
#   network stalls; too large keeps dead connections around.
ITC_CONNECTION_TIMEOUT=
